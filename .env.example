# ========== 必填 ==========
LLM_API_KEY=your_api_key
ONEDBA_ACCESS_TOKEN=your_onedba_access_token

# ========== LLM 配置 ==========
LLM_BASE_URL=https://dwai-data.dewu-inc.com/openai/v1
LLM_MODEL=deepseek-v4-flash-260425

# ========== OneDBA 配置 ==========
ONEDBA_BASE_URL=https://onedba.shizhuang-inc.com

# ========== Langfuse 可观测性（可选）==========
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ========== 语义规则配置 ==========
SEMANTIC_PROVIDER=auto
SEMANTIC_RULES_PATH=data/semantic_rules.json
SEMANTIC_USER_RULES_PATH=data/user_semantic_rules.json
SEMANTIC_DEFAULT_DOMAIN=mysql_sandbox

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ========== OpenViking 对话记忆（可选）==========
KB_ENABLED=false
KB_OPENVIKING_URL=http://localhost:1933
KB_AUTO_COMMIT_TURNS=10

# ========== 会话存储 ==========
# 可选值: memory（默认，进程内存储，重启丢失）| sqlite（持久化到 data/sessions.db）
STORAGE_BACKEND=memory
# STORAGE_FILE_PATH=data/sessions.db