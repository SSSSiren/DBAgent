# ========== 必填（生产请填真实值；compose 用 ${VAR:?} 约束，缺失即拒绝启动）==========
LLM_API_KEY=your_api_key
ONEDBA_ACCESS_TOKEN=your_onedba_access_token
# OneDBA 环境：prd/test/uat/dev/pre，生产用 prd
ONEDBA_ENV=test
# Admin API Bearer token；留空则 /api/admin/* 返回 503。生产用强随机值：openssl rand -hex 24
ADMIN_API_TOKEN=

# ========== LLM 配置 ==========
LLM_BASE_URL=https://dwai-data.dewu-inc.com/openai/v1
LLM_MODEL=deepseek-v4-flash-260425

# ========== OneDBA 配置 ==========
ONEDBA_BASE_URL=https://onedba.shizhuang-inc.com

# ========== Langfuse 可观测性（可选，生产建议开启便于排障）==========
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ========== 服务配置 ==========
HOST=0.0.0.0
PORT=8000
DEBUG=false
# 宿主端口映射（compose 用），默认 8000
HOST_PORT=8000
# gunicorn worker 数；不设则按 (2*CPU+1) 自动计算（上限 8）。勿设空字符串，会导致启动崩溃
WEB_CONCURRENCY=

# ========== OpenViking 对话记忆（可选）==========
KB_ENABLED=false
KB_OPENVIKING_URL=http://localhost:1933
KB_AUTO_COMMIT_TURNS=10

# ========== 会话存储 ==========
# 可选值: memory（进程内存储，重启丢失，仅演示）/ sqlite（持久化到 data/sessions.db，生产推荐）
# 注意：当前代码仅实现 memory/sqlite 两种后端，未实现 redis（redis_url 配置项预留，选 redis 会启动报错）
STORAGE_BACKEND=sqlite
STORAGE_FILE_PATH=data/sessions.db
# Redis 预留（暂未实现，勿启用）
REDIS_URL=

# ========== 操作记忆（查询偏好）==========
PREFERENCE_ENABLED=true

# ========== SQL 历史记忆（可选）==========
# 启用后 Agent 自动记录每次成功的 SQL 及执行结果，后续对话中通过语义检索注入相关历史 SQL 作为 few-shot 参考。
SQL_MEMORY_ENABLED=true
# 语义检索返回条数（默认 5）
SQL_MEMORY_TOP_K=5
# 注入上下文的最大字符数（默认 1500）
SQL_MEMORY_TOKEN_BUDGET=1500
# 单条 SQL 存储长度上限（默认 2000）
SQL_MEMORY_SQL_MAX_LENGTH=2000
# 记忆记录过期天数（默认 90）
SQL_MEMORY_TTL_DAYS=90
# 语义检索最低相似度阈值（默认 0.0，不过滤）
SQL_MEMORY_MIN_SIMILARITY=0.0
# 模式挖掘触发所需最小记录数（默认 20）
SQL_MEMORY_PATTERN_MIN_RECORDS=20
# 作用域模式: user（仅自己）/ database（同库共享）/ mixed（混合）
SQL_MEMORY_SCOPE=user
# Embedding 提供方: ollama（本地 bge-m3，容器内通常无此服务）/ openai（远程 API，生产推荐）/ auto（OpenAI优先回退Ollama）
# 生产建议: openai 或 auto，避免依赖容器内不存在的 ollama
LLM_EMBEDDING_PROVIDER=auto
# OpenAI embedding 模型（仅 provider=openai 或 auto 时使用）
LLM_EMBEDDING_MODEL=text-embedding-3-small
# Ollama 配置（仅 provider=ollama 或 auto 时使用）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:latest

# ========== HDC 数据底座（可选）==========
# 启用后 Agent 在 NL2SQL 前会注入数据库的语义元数据（表/列业务含义）作为列描述段，
# 提升生成准确率；首次启用会触发语义生成，依赖 OpenViking（KB_OPENVIKING_URL）与 embedding 服务。
# 未启用时 /api/hdc/* 端点返回 404，HDC 逻辑整体跳过。
HDC_ENABLED=false
# 自动离线生成 HDC 语义（关闭则需手动调 /api/hdc/generate 触发）
HDC_AUTO_GENERATE=false
# 等待 SemanticProcessor 写入完成（wait=True）的超时秒数
HDC_SEMANTIC_TIMEOUT=300
# 注入 NL2SQL prompt 的 HDC 列描述段字符预算
HDC_COLUMN_BUDGET=1200

# ========== Admin API（可选）==========
# 启用后可通过 /api/admin/* 端点管理 HDC namespace 映射和 SQL Memory
# 留空则 Admin API 不可用，所有端点返回 503
ADMIN_API_TOKEN=